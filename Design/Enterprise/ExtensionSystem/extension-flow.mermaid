flowchart TD

    subgraph DEV["Development"]
        T[Create repo from GitHub template]
        T --> C1[Compute extension<br/>C++ or Python, implements IExtension]
        T --> G1[GUI extension<br/>Python only, implements IMenuContribution etc]
        T --> D1[Data-only extension<br/>instrument/facility config]
        T --> U1[Future-language extension<br/>e.g. Rust, implements stable C ABI directly]
    end

    subgraph BUILD["SDK build step, C++ and Python compute path"]
        B1[Compile native library]
        B2[Generate pybind11 bindings<br/>Binder codegen or cppyy reflection<br/>over the concrete class]
        B3[Emit registry descriptor<br/>name, version, parameter schema]
        B4[Generate vtable shim<br/>thin C++ wrapper over the stable C ABI]
        C1 --> B1
        B1 --> B2
        C1 --> B3
        B1 --> B4
    end

    subgraph PKG["Packaging, all paths converge here"]
        P1[Conda package]
        P2[Declares mantid-extension-abi constraint<br/>propagated via run_exports]
        B1 --> P1
        B2 --> P1
        B3 --> P1
        B4 --> P1
        U1 --> P1
        G1 --> P1
        D1 --> P1
        P1 --> P2
    end

    subgraph CI["Branch and release workflow"]
        R1[Feature branch, PR, merge to main]
        R2[Deploy to dev environment<br/>automatic, no approval]
        R3[Approve qa environment<br/>one click]
        R4[Approve production environment<br/>two clicks]
        R5[Publish release<br/>tag auto-created]
        P2 --> R1 --> R2 --> R3 --> R4 --> R5
    end

    subgraph DIST["Distribution"]
        X1[Actions builds and packages]
        X2[Published to channel<br/>conda-forge or facility channel]
        X3[Autotick bot opens feedstock PR]
        X4[Merge or automerge]
        R5 --> X1 --> X2
        X2 --> X3 --> X4
    end

    subgraph DEPLOY["Deployment, scoped by the site, not governed by Mantid"]
        Y1[Included in a deployment manifest]
        Y2[pixi solves full dependency graph<br/>enforces abi constraint]
        Y3[Locked environment installed to server]
        X2 --> Y1
        X4 --> Y1
        Y1 --> Y2 --> Y3
    end

    subgraph LAUNCH["Launch and registration"]
        L1[Native lib lands in plugin directory convention]
        L2[Python module lands in site-packages<br/>with mantid.extensions entry point]
        L3[Core scans plugin directory, dlopen]
        L4[Python import via entry point<br/>if Python present]
        L5[Explicit registration entry point called<br/>any language exporting a compatible C ABI]
        L6[GUI extension registers<br/>via mantidworkbench entry point groups]
        Y3 --> L1
        Y3 --> L2
        L1 --> L3
        L2 --> L4
        L3 --> L5
        L4 --> L5
        Y3 --> L6
    end

    subgraph RUNTIME["Mounted and running"]
        N1[Core registry<br/>compute extensions, callable via IExtension vtable]
        N2[Workbench GUI registry<br/>menus, docks, views]
        N3[Every dispatch call<br/>passively records provenance]
        N4[Workspace lineage travels with the data<br/>mirrored into NXprocess]
        L5 --> N1
        L6 --> N2
        N1 --> N3 --> N4
    end

    subgraph GOVERN["Facility data governance, for data-only extensions"]
        F1[Calibration validity registry<br/>run number or time window, recorded hash]
        F2[Content-addressed store<br/>fetches bytes, computes hash]
        F3{Hashes match?}
        F4[Proceed, record in provenance]
        F5[Flagged as anomaly, surfaced]
        L5 --> F1
        F1 --> F2 --> F3
        F3 -->|yes| F4
        F3 -->|no| F5
    end

    classDef compute fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a
    classDef gui fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95
    classDef data fill:#dcfce7,stroke:#22c55e,color:#14532d
    classDef future fill:#ffedd5,stroke:#f97316,color:#7c2d12
    classDef infra fill:#f3f4f6,stroke:#6b7280,color:#111827

    class C1,B1,B2,B3,B4,N1,N3 compute
    class G1,L6,N2 gui
    class D1,F1,F2,F3,F4,F5 data
    class U1 future
    class T,P1,P2,R1,R2,R3,R4,R5,X1,X2,X3,X4,Y1,Y2,Y3,L1,L2,L3,L4,L5,N4 infra